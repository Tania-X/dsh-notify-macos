{
  "name": "dsh-notify-macos",
  "version": "0.3.0",
  "description": "DSH plugin: persistent top-right floating cards on macOS — click to jump straight to the finished conversation's position",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "remote"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "bin"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tania-X/dsh-notify-macos.git"
  },
  "homepage": "https://github.com/Tania-X/dsh-notify-macos#readme",
  "bugs": {
    "url": "https://github.com/Tania-X/dsh-notify-macos/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "macos",
    "notification",
    "cordis"
  ],
  "engines": {
    "node": ">=22"
  }
}
